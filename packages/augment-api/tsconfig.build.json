{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "paths": {
      "@cord.network/augment-api/extraDefs": [
        "./src/extraDefs.ts"
      ]
    }
  },
  "include": [
    "src/index.ts",
    "src/compat.ts",
    "src/extraDefs.ts"
  ],
  "exclude": [
    "coverage",
    "**/*.spec.ts"
  ],
}
