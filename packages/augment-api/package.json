{
  "name": "@cord.network/augment-api",
  "version": "0.9.6-1",
  "description": "",
  "types": "./lib/index.d.ts",
  "main": "./index.cjs",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./extraDefs": {
      "types": "./lib/extraDefs.d.ts"
    }
  },
  "files": [
    "lib/**/*",
    "index.mjs",
    "index.cjs"
  ],
  "scripts": {
    "clean": "rimraf ./lib",
    "build": "yarn clean && yarn build:ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "update-metadata": "node ./scripts/fetchMetadata.cjs -o './metadata/cord.json' -e 'wss://staging.cord.network/'"
  },
  "repository": "github:dhiway/cord.js",
  "engines": {
    "node": ">=20.0"
  },
  "author": "Dhiway <info@dhiway.com>",
  "license": "Apache-2.0",
  "bugs": "https://github.com/dhiway/cord.js/issues",
  "homepage": "https://github.com/dhiway/cord.js#readme",
  "devDependencies": {
    "@types/node": "26.1.1",
    "polkadot-api": "2.1.8",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "yargs": "18.0.0"
  },
  "dependencies": {
    "@cord.network/types": "workspace:*"
  }
}
